{#
    Configlet to provision a "Protect RE" filter on Junos devices.  Requires
    the protect-re_junos.prop.json property set is included in any blueprint
    that uses this configlet.
#}

{#
    We use prefix lists to establish groups of addresses that can be used 
    as match conditions in the firewall filters (aka ACL's) below.
#}
policy-options {
    replace: prefix-list BGP_PEERS {
        /* Generated by configlet */
{% for name, session in bgp_sessions.items() %}
        {{ session.dest_ip }};
{% endfor %}
    }
{% if 'mgt_prefix_list' in protect_re and protect_re.mgt_prefix_list is truthy %}
    replace: prefix-list MGT_NETS {
        /* Generated by configlet */
    {% for prefix in protect_re.mgt_prefix_list %}
        {{ prefix }};
    {% endfor %}
  }
{% endif %}
}

{#
    Now we create the firewall filter named PROTECT_RE.  This is just
    notional; you should definitely expand upon this example...
#}
firewall {
    family inet {
        /* Generated by configlet */
        filter PROTECT_RE {
            term ONE__ACCEPT-from-MGT-NETS {
                from {
                    source-prefix-list {
                        MGT_NETS;
                    }
                }
                then accept;
            }
            term TWO__ACCEPT-BGP-from-PEERS {
                from {
                    prefix-list {
                        BGP_PEERS;
                    }
                    protocol tcp;
                    port 179;
                }
                then accept;
            }
            term THREE__ACCEPT-BASIC-ICMP {
                from {
                    protocol icmp;
                    icmp-type [ echo-request time-exceeded unreachable ];
                }
                then accept;
            }
            term ELSE__DISCARD-TRAFFIC {
                then {
                    discard;
                }
            }
        }
    }
}

{# Now apply that filter to the loopback interface #}
interfaces {
    lo0 {
        unit 0 {
            family inet {
                filter {
                    input PROTECT_RE;
                }
            }
        }
    }
}
