{#
    Configlet to provision a "Protect RE" filter on Junos devices.  Requires
    the protect-re_junos.prop.json property set is included in any blueprint
    that uses this configlet.

    Last Updated: 2026-10-09
#}

{#
    First we create the firewall filter named PROTECT_RE.  This is just
    notional; you should definitely expand upon this example...
#}
firewall {
    family inet {
        /* Generated by configlet */
        replace: filter PROTECT_RE {
            term ALLOW_BGP_from_PEERS {
                from {
                    source-address {
{% for name, session in bgp_sessions.items() %}
                        {{ session.dest_ip }};
{% endfor %}
                    }
                    protocol tcp;
                    port 179;
                }
                then accept;
            }
            term ALLOW_BFD_from_BGP_PEERS {
                from {
                    source-address {
{% for name, session in bgp_sessions.items() %}
                        {{ session.dest_ip }};
{% endfor %}
                    }
                    protocol udp;
                    port 49152;
                }
                then accept;
            }
            term ALLOW_BASIC_ICMP {
                from {
                    protocol icmp;
                    icmp-type [ 
{%- for type in protect_re['icmp_allowed_types'] %} {{ type }} {% endfor -%} ];
                }
                then accept;
            }
{% for term in protect_re['terms'] %}
            term {{ term['service'] }} {
                from {
    {% if term['src_prefixes'] is defined and term['src_prefixes'] != '' %}
                    source-address {
        {% for prefix in term['src_prefixes'] %}
                        {{ prefix }};
        {% endfor %}
                    }
    {% endif %}
    {% if term['protocol'] is defined and term['protocol'] != '' %}
                    protocol {{ term['protocol'] }};
    {% endif %}
    {% if term['ports'] is defined and term['ports'] != [] %}
                    port [ {% for port in term['ports'] %} {{ port }} {% endfor %} ];
    {% endif %}
                }
    {% if term['actions'] is defined and term['actions'] != [] %}
                then {
        {% for action in term['actions'] %}
                    {{ action }};
        {% endfor %}
                }
    {% endif %}
            }
{% endfor %}
            term ELSE__DEFAULT_ACTIONS {
{% if protect_re['default_actions'] is defined and protect_re['default_actions'] != [] %}
                then {
    {% for action in protect_re['default_actions'] %}
                    {{ action }};
    {% endfor %}
                }
{% else %}
                then {
                    discard;
                }
{% endif %}
            }
        }
    }
}

{# Now apply that filter to the loopback interface #}
interfaces {
    lo0 {
        unit 0 {
            family inet {
                filter {
                    input PROTECT_RE;
                }
            }
        }
    }
}
